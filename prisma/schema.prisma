// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider   = "postgresql"
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String?
  displayName         String?
  firstName           String?
  lastName            String?
  phone               String?
  dateOfBirth         String?
  avatarUrl           String?
  bannerUrl           String?
  preferences         Json?
  userTypes           Json?      // Guarda los estados de cada rol (client, business, delivery)
  currentUserType     String?
  currentBusinessId   String?
  currentBusiness     Business?  @relation("UserCurrentBusiness", fields: [currentBusinessId], references: [id])
  currentBranchId     String?
  currentBranch       Branch?    @relation("UserCurrentBranch", fields: [currentBranchId], references: [id])
  lastUserTypeSwitch  DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  ownedBusinesses     Business[] @relation("BusinessOwner")
  posts               Post[]
  stories             Story[]
  addresses           Address[]
  favorites           Favorite[]
  follows             Follow[]
  clientOrders        Order[]    @relation("ClientOrders")
}

model Business {
  id              String     @id @default(uuid())
  ownerId         String
  owner           User       @relation("BusinessOwner", fields: [ownerId], references: [id])
  businessName    String
  businessType    String?
  category        String?
  description     String?
  businessHours   String?
  isActive        Boolean    @default(true)
  isVerified      Boolean    @default(false)
  isFeatured      Boolean    @default(false)
  followersCount  Int        @default(0)
  viewCount       Int        @default(0)
  rating          Decimal    @default(0.0) @db.Decimal(3, 2)
  reviewsCount    Int        @default(0)
  logoUrl         String?
  bannerUrl       String?
  status          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  branches        Branch[]
  products        Product[]
  posts           Post[]
  stories         Story[]
  followers       Follow[]
  usersCurrentlyHere User[]  @relation("UserCurrentBusiness")
  orders          Order[]
  categories      Category[]
}

model Branch {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  name            String
  isMain          Boolean    @default(false)
  isActive        Boolean    @default(true)
  address         Json?
  latitude        Decimal?
  longitude       Decimal?
  phone           String?
  status          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  usersCurrentlyHere User[]  @relation("UserCurrentBranch")
  orders             Order[]
}

model Category {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  name            String
  iconUrl         String?
  productCount    Int        @default(0)

  products        Product[]
}

model Product {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  price           Decimal    @db.Decimal(10, 2)
  discountPrice   Decimal?   @db.Decimal(10, 2)
  currency        String     @default("USD")
  isDiscountActive Boolean   @default(false)
  hasVariants     Boolean    @default(false)
  thumbnailUrl    String?
  images          Json?
  isActive        Boolean    @default(true)
  isAvailable     Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  viewCount       Int        @default(0)
  favoriteCount   Int        @default(0)
  orderCount      Int        @default(0)
  rating          Decimal    @default(0.0) @db.Decimal(3, 2)
  reviewCount     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  orderItems      OrderItem[]
}

model Post {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  type            String     // image, video, carousel
  title           String?
  caption         String?
  media           Json?      // Arreglo con URLs y metadatos
  thumbnailUrl    String?
  isActive        Boolean    @default(true)
  isPublished     Boolean    @default(false)
  isPinned        Boolean    @default(false)
  likeCount       Int        @default(0)
  commentCount    Int        @default(0)
  shareCount      Int        @default(0)
  viewCount       Int        @default(0)
  saveCount       Int        @default(0)
  keywords        Json?
  mentions        Json?
  taggedProducts  Json?      // Guarda {productId, position: {x,y}}
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Story {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  mediaUrl        String
  mediaType       String     // image, video
  thumbnailUrl    String?
  duration        Int?       // For videos
  tags            Json?
  viewCount       Int        @default(0)
  expiresAt       DateTime
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Address {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  typeId          String
  type            AddressType    @relation(fields: [typeId], references: [id])
  stateId         String
  state           VenezuelanState @relation(fields: [stateId], references: [id])
  city            String
  street          String
  details         String?
  latitude        Decimal?
  longitude       Decimal?
  isDefault       Boolean        @default(false)
}

model AddressType {
  id              String     @id @default(uuid())
  name            String
  icon            String?
  addresses       Address[]
}

model VenezuelanState {
  id              String     @id @default(uuid())
  name            String
  addresses       Address[]
}

model Favorite {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  entityId        String     // Polymorphic UUID
  entityType      String     // product or business
  createdAt       DateTime   @default(now())

  @@unique([userId, entityId, entityType])
}

model Follow {
  id              String     @id @default(uuid())
  followerId      String
  follower        User       @relation(fields: [followerId], references: [id])
  followingId     String
  following       Business   @relation(fields: [followingId], references: [id])
  createdAt       DateTime   @default(now())

  @@unique([followerId, followingId])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  clientId        String
  client          User        @relation("ClientOrders", fields: [clientId], references: [id])
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id])
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  status          String      @default("pending")
  totalAmount     Decimal     @db.Decimal(10, 2)
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0.0) @db.Decimal(10, 2)
  deliveryAddress Json?
  paymentMethod   String?
  paymentStatus   String      @default("pending")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id              String      @id @default(uuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Int         @default(1)
  unitPrice       Decimal     @db.Decimal(10, 2)
  totalPrice      Decimal     @db.Decimal(10, 2)
  options         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model UserInteraction {
  id              String      @id @default(uuid())
  userId          String?
  action          String      // LIKE_POST, COMMENT_POST, SHARE_POST, VIEW_POST, VIEW_BUSINESS, FAVORITE_POST, FAVORITE_PRODUCT
  postId          String?
  productId       String?
  businessId      String?
  metadata        Json?
  createdAt       DateTime    @default(now())
}
