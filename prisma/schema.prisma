// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider   = "postgresql"
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String?
  displayName         String?
  firstName           String?
  lastName            String?
  phone               String?
  dateOfBirth         String?
  avatarUrl           String?
  bannerUrl           String?
  preferences         Json?
  userTypes           Json?      // Guarda los estados de cada rol (client, business, delivery)
  currentUserType     String?
  role                String     @default("user") // user | admin (super user dashboard)
  currentBusinessId   String?
  currentBusiness     Business?  @relation("UserCurrentBusiness", fields: [currentBusinessId], references: [id])
  currentBranchId     String?
  currentBranch       Branch?    @relation("UserCurrentBranch", fields: [currentBranchId], references: [id])
  lastUserTypeSwitch  DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  ownedBusinesses     Business[] @relation("BusinessOwner")
  posts               Post[]
  stories             Story[]
  addresses           Address[]
  favorites           Favorite[]
  follows             Follow[]
  clientOrders        Order[]    @relation("ClientOrders")
  comments            Comment[]
  activityDays        UserActivityDay[]
}

model Business {
  id              String     @id @default(uuid())
  ownerId         String
  owner           User       @relation("BusinessOwner", fields: [ownerId], references: [id])
  businessName    String
  businessType    String?
  category        String?
  description     String?
  businessHours   String?
  isActive        Boolean    @default(true)
  isVerified      Boolean    @default(false)
  isFeatured      Boolean    @default(false)
  followersCount  Int        @default(0)
  viewCount       Int        @default(0)
  rating          Decimal    @default(0.0) @db.Decimal(3, 2)
  reviewsCount    Int        @default(0)
  logoUrl         String?
  bannerUrl       String?
  status          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  branches        Branch[]
  products        Product[]
  posts           Post[]
  stories         Story[]
  followers       Follow[]
  usersCurrentlyHere User[]  @relation("UserCurrentBusiness")
  orders          Order[]
  categories      Category[]
  paymentAccounts    BusinessPaymentAccount[]
  commissionPayments CommissionPayment[]
}

model Branch {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  name            String
  isMain          Boolean    @default(false)
  isActive        Boolean    @default(true)
  address         Json?
  latitude        Decimal?
  longitude       Decimal?
  phone           String?
  status          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  usersCurrentlyHere User[]  @relation("UserCurrentBranch")
  orders             Order[]
}

model Category {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  name            String
  iconUrl         String?
  productCount    Int        @default(0)

  products        Product[]
}

model Product {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  price           Decimal    @db.Decimal(10, 2)
  discountPrice   Decimal?   @db.Decimal(10, 2)
  currency        String     @default("USD")
  isDiscountActive Boolean   @default(false)
  hasVariants     Boolean    @default(false)
  thumbnailUrl    String?
  images          Json?
  isActive        Boolean    @default(true)
  isAvailable     Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  viewCount       Int        @default(0)
  favoriteCount   Int        @default(0)
  orderCount      Int        @default(0)
  rating          Decimal    @default(0.0) @db.Decimal(3, 2)
  reviewCount     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  orderItems      OrderItem[]
}

model Post {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  type            String     // image, video, carousel
  title           String?
  caption         String?
  media           Json?      // Arreglo con URLs y metadatos
  thumbnailUrl    String?
  isActive        Boolean    @default(true)
  isPublished     Boolean    @default(false)
  isPinned        Boolean    @default(false)
  likeCount       Int        @default(0)
  commentCount    Int        @default(0)
  shareCount      Int        @default(0)
  viewCount       Int        @default(0)
  saveCount       Int        @default(0)
  keywords        Json?
  mentions        Json?
  taggedProducts  Json?      // Guarda {productId, position: {x,y}}
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  comments        Comment[]
}

model Comment {
  id              String     @id @default(uuid())
  postId          String
  post            Post       @relation(fields: [postId], references: [id])
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  content         String
  parentId        String?
  parent          Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[]  @relation("CommentReplies")
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([postId])
  @@index([parentId])
}

model Story {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  mediaUrl        String
  mediaType       String     // image, video
  thumbnailUrl    String?
  duration        Int?       // For videos
  tags            Json?
  viewCount       Int        @default(0)
  expiresAt       DateTime
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Address {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  typeId          String
  type            AddressType    @relation(fields: [typeId], references: [id])
  stateId         String
  state           VenezuelanState @relation(fields: [stateId], references: [id])
  city            String
  street          String
  details         String?
  latitude        Decimal?
  longitude       Decimal?
  isDefault       Boolean        @default(false)
}

model AddressType {
  id              String     @id @default(uuid())
  name            String
  icon            String?
  addresses       Address[]
}

model VenezuelanState {
  id              String     @id @default(uuid())
  name            String
  addresses       Address[]
}

model Favorite {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  entityId        String     // Polymorphic UUID
  entityType      String     // product or business
  createdAt       DateTime   @default(now())

  @@unique([userId, entityId, entityType])
}

model Follow {
  id              String     @id @default(uuid())
  followerId      String
  follower        User       @relation(fields: [followerId], references: [id])
  followingId     String
  following       Business   @relation(fields: [followingId], references: [id])
  createdAt       DateTime   @default(now())

  @@unique([followerId, followingId])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  clientId        String
  client          User        @relation("ClientOrders", fields: [clientId], references: [id])
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id])
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  status          String      @default("pending")
  totalAmount     Decimal     @db.Decimal(10, 2)
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0.0) @db.Decimal(10, 2)
  deliveryMethod  String      @default("delivery") // delivery | pickup
  deliveryAddress Json?       // { latitude, longitude, address } shared by the client
  paymentMethod   String?     // pago_movil | efectivo | zelle | transferencia
  paymentStatus   String      @default("pending") // pending | paid
  notes           String?
  cancelReason    String?
  statusHistory   Json?       // [{ status, at, by }]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id              String      @id @default(uuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Int         @default(1)
  unitPrice       Decimal     @db.Decimal(10, 2)
  totalPrice      Decimal     @db.Decimal(10, 2)
  options         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model UserInteraction {
  id              String      @id @default(uuid())
  userId          String?
  action          String      // LIKE_POST, COMMENT_POST, SHARE_POST, VIEW_POST, VIEW_BUSINESS, FAVORITE_POST, FAVORITE_PRODUCT
  postId          String?
  productId       String?
  businessId      String?
  metadata        Json?
  createdAt       DateTime    @default(now())
}

model Conversation {
  id                String      @id @default(uuid())
  participant1Id    String
  participant1Type  String      // 'user' | 'business'
  participant2Id    String
  participant2Type  String      // 'user' | 'business'
  lastMessage       String?
  lastMessageAt     DateTime?   @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  messages          Message[]

  @@index([participant1Id])
  @@index([participant2Id])
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  senderType      String        // 'user' | 'business'
  receiverId      String
  receiverType    String        // 'user' | 'business'
  content         String
  mediaUrl        String?
  isRead          Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([conversationId])
  @@index([receiverId])
}

// Where a business receives payments; sent to clients from the chat wallet
model BusinessPaymentAccount {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  type            String     // pago_movil | zelle | binance
  bankName        String?    // pago_movil
  holderName      String?
  documentId      String?    // cédula / RIF (pago_movil)
  phone           String?    // pago_movil, zelle
  email           String?    // zelle, binance
  accountId       String?    // Binance Pay ID
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([businessId])
}

// A business reporting payment of one month's app commission
model CommissionPayment {
  id               String     @id @default(uuid())
  businessId       String
  business         Business   @relation(fields: [businessId], references: [id])
  period           String     // YYYY-MM
  salesAmount      Decimal    @db.Decimal(12, 2)
  commissionAmount Decimal    @db.Decimal(12, 2)
  rate             Decimal    @db.Decimal(5, 4)
  status           String     @default("reported") // reported | confirmed | rejected
  method           String?
  reference        String?
  receiptUrl       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([businessId, period])
}

// One row per user per day they used the app, to count monthly active users
model UserActivityDay {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  day       String   // YYYY-MM-DD (Venezuela time)
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}
